# Synology Local NAS Configuration
SYNO_LOCAL_IP=192.168.1.100
SYNO_LOCAL_PORT=5000
SYNO_USE_HTTPS=false
SYNO_VERIFY_SSL=true
SYNO_USER=hermes_bot
SYNO_PASS=YourSecurePassword

# Optional: Default Download Share/Folder on NAS (e.g., "downloads" or "volume1/downloads")
# Set this if Download Station does not have a default location set in DSM Settings.
SYNO_DEFAULT_DESTINATION=downloads

# Telegram Notification Configuration (Optional - for Option B Polling)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
